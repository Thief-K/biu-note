{
  "name": "BiuNote",
  "version": "1.0.5",
  "private": true,
  "description": "Pure Markdown Note-Taking App with Integrated AI Copilot",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --filter biunote-backend dev\" \"pnpm --filter biunote-frontend dev\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint ./",
    "format": "oxfmt ./",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "concurrently": "^8.2.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "7.0.2",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
